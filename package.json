{
  "name": "factory-shark",
  "version": "1.1.0",
  "description": "TypeScript test factories for Sequelize with declarative associations",
  "license": "Apache-2.0",
  "author": "Marlen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/factory-shark.git"
  },
  "homepage": "https://github.com/klondikemarlen/factory-shark#readme",
  "bugs": "https://github.com/klondikemarlen/factory-shark/issues",
  "keywords": [
    "sequelize",
    "factory",
    "testing",
    "typescript"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/verify-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run smoke",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@sequelize/core": "7.0.0-alpha.48",
    "sequelize": "^6.37.8"
  },
  "peerDependenciesMeta": {
    "@sequelize/core": {
      "optional": true
    },
    "sequelize": {
      "optional": true
    }
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.20.0",
    "@types/semver": "^7.8.0",
    "prettier": "3.9.10",
    "sequelize": "6.37.8",
    "sqlite3": "^5.1.7",
    "tsc-alias": "1.9.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
